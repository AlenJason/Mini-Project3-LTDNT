# Copy file này thành `.env` nếu cần chỉnh.

# Địa chỉ server realtime (Express + Socket.IO trong thư mục server/).
# Để trống thì app tự chọn:
# - Web dev (npm run dev):  http://<hostname-đang-mở>:4000
# - Web build do server phục vụ: cùng địa chỉ với trang
# - Android emulator:        http://10.0.2.2:4000
# - iOS simulator:           http://localhost:4000
# Điện thoại thật: đặt http://<IP-LAN-của-máy-tính>:4000 — hoặc đổi ngay trong
# app ở tab "Cá nhân" -> "Máy chủ realtime", không cần build lại.
VITE_SERVER_URL=
