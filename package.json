    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
