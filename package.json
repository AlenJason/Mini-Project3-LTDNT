{
  "name": "mini-project3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\"",
